REG_DATABASE_URL=postgresql://reg_app:CHANGE_ME@127.0.0.1:21055/nst_regulation
REG_MIGRATOR_URL=postgresql://reg_migrator:CHANGE_ME@127.0.0.1:21055/nst_regulation
REG_S3_ENDPOINT=http://127.0.0.1:21066
REG_S3_BUCKET=regulation
REG_S3_ACCESS_KEY=CHANGE_ME
REG_S3_SECRET_KEY=CHANGE_ME
REG_LAWGO_OC=CHANGE_ME
REG_ALIO_MIN_INTERVAL=1.5
REG_LAWGO_MIN_INTERVAL=1.0
REG_OS_URL=http://127.0.0.1:21067
REG_EMBED_URL=http://192.168.0.2:8002
REG_EMBED_MODEL=bge-m3
REG_RERANK_URL=http://192.168.0.2:8003
REG_RERANK_MODEL=bge-reranker
REG_LLM_URL=http://192.168.0.2:8001
REG_LLM_MODEL=llm
REG_NEO4J_PASSWORD=CHANGE_ME
REG_SMTP_HOST=127.0.0.1
REG_SMTP_PORT=21068
# --- Airflow (infra/docker-compose.yml, docs/ops/airflow.md) ---
# 컨테이너 안에서 쓰는 주 DB 주소: 호스트가 postgres:5432 (nais_default 네트워크). 계정·DB는 REG_DATABASE_URL과 같게.
REG_DATABASE_URL_DOCKER=postgresql://reg_app:CHANGE_ME@postgres:5432/nst_regulation
# 컨테이너 안에서 쓰는 OpenSearch 주소 (GPU PC 전용 클러스터, 계정 포함)
REG_OS_URL_DOCKER=http://reg_app:CHANGE_ME@192.168.0.2:8005
# 메타 DB reg_airflow 비밀번호 (영숫자만: 접속 URL에 그대로 들어감). scripts/airflow.sh init-db가 역할을 만든다.
REG_AIRFLOW_DB_PASSWORD=CHANGE_ME
# 만들기: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
REG_AIRFLOW_FERNET_KEY=CHANGE_ME
# 만들기: python3 -c "import secrets;print(secrets.token_urlsafe(32))"  (두 값은 서로 다르게)
REG_AIRFLOW_SECRET_KEY=CHANGE_ME
REG_AIRFLOW_JWT_SECRET=CHANGE_ME
# UI(21062) 관리자. airflow-init이 없을 때만 만든다.
REG_AIRFLOW_ADMIN_USER=admin
REG_AIRFLOW_ADMIN_PASSWORD=CHANGE_ME
# OpenSearch Dashboards 내부 계정(kibanaserver) 비밀번호 (GPU PC 클러스터)
REG_OS_DASHBOARDS_PASSWORD=CHANGE_ME
